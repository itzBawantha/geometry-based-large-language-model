// =============================================================================
// Generalized CUDA PTX Kernels for Geometry-Based Large Language Model (GLLM)
// Target: sm_52+ (JIT-compiled by NVIDIA CUDA Driver to native GPU SASS)
//
// Kernels:
//   1. init_outer_shell_dynamic : Populates all 1,200,000 outer-shell points;
//                                 indices 0..num_classes-1 get assigned class
//                                 points (visible); rest stay hidden in VRAM.
//   2. train_accumulate_shadows : Accumulates arbitrary WxH 8-bit image batches
//                                 into per-class shadow maps via atomicAdd.
//   3. eval_score_shadows       : Scores unseen test images against all trained
//                                 class shadow templates on GPU (cosine match).
//   4. emit_allocated_regions   : O(Allocated Points) renderer supporting even
//                                 a 1-BILLION-POINT lattice (G=1241) at 60 FPS!
// =============================================================================

.version 7.0
.target sm_52
.address_size 64

// -----------------------------------------------------------------------------
// Kernel 1: Dynamic 1,200,000-Point Outer Spherical Shell (R = 1.0)
// -----------------------------------------------------------------------------
.visible .entry init_outer_shell_dynamic(
    .param .u64 param_out_vbo,
    .param .u32 param_total_pts,
    .param .u64 param_assigned_pts, // float4[num_classes]: {x, y, z, class_id}
    .param .u32 param_num_classes
)
{
    .reg .pred %p<3>;
    .reg .u32  %r<22>;
    .reg .u64  %rd<8>;
    .reg .f32  %f<22>;

    ld.param.u64 %rd0, [param_out_vbo];
    ld.param.u32 %r0,  [param_total_pts];
    ld.param.u64 %rd1, [param_assigned_pts];
    ld.param.u32 %r1,  [param_num_classes];

    mov.u32    %r2, %ctaid.x;
    mov.u32    %r3, %ntid.x;
    mov.u32    %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;      // idx
    setp.ge.u32 %p0, %r5, %r0;
    @%p0 bra SHELL_DONE;

    setp.lt.u32 %p1, %r5, %r1;
    @%p1 bra ASSIGNED_PT;

    // Unassigned outer-shell points stay resident in VRAM on R = 1.0 (val = -1.0 -> hidden)
    shl.b32    %r6, %r5, 1;
    add.u32    %r6, %r6, 1;
    mad.lo.u32 %r7, %r6, 747796405, 2891336453;
    shr.u32    %r8, %r7, 28;
    add.u32    %r8, %r8, 4;
    shr.u32    %r9, %r7, %r8;
    xor.b32    %r9, %r9, %r7;
    mul.lo.u32 %r9, %r9, 277803737;
    shr.u32    %r10, %r9, 22;
    xor.b32    %r10, %r10, %r9;
    shr.u32    %r10, %r10, 8;
    cvt.rn.f32.u32 %f0, %r10;
    mul.f32    %f0, %f0, 0f33800000;
    fma.rn.f32 %f1, %f0, 0f40000000, 0fbf800000; // ny

    add.u32    %r11, %r6, 1;
    mad.lo.u32 %r12, %r11, 747796405, 2891336453;
    shr.u32    %r13, %r12, 28;
    add.u32    %r13, %r13, 4;
    shr.u32    %r14, %r12, %r13;
    xor.b32    %r14, %r14, %r12;
    mul.lo.u32 %r14, %r14, 277803737;
    shr.u32    %r15, %r14, 22;
    xor.b32    %r15, %r15, %r14;
    shr.u32    %r15, %r15, 8;
    cvt.rn.f32.u32 %f2, %r15;
    mul.f32    %f2, %f2, 0f33800000;
    mul.f32    %f2, %f2, 0f40c90fdb;

    mul.f32         %f3, %f1, %f1;
    sub.f32         %f3, 0f3f800000, %f3;
    max.f32         %f3, %f3, 0f00000000;
    sqrt.approx.f32 %f4, %f3;

    sin.approx.f32  %f5, %f2;
    cos.approx.f32  %f6, %f2;
    mul.f32         %f7, %f6, %f4;      // nx
    mul.f32         %f8, %f5, %f4;      // nz

    fma.rn.f32 %f9,  %f1, 0f3f000000, 0f3f000000;
    sub.f32    %f10, 0f3f800000, %f9;
    fma.rn.f32 %f11, %f10, 0f3ee66666, 0f3e19999a;
    fma.rn.f32 %f12, %f9,  0f3f19999a, 0f3e4ccccd;
    mov.f32    %f13, 0f3f666666;
    mov.f32    %f14, 0fbf800000;        // value = -1.0 (unassigned -> hidden)
    mov.f32    %f15, 0f00000000;
    bra WRITE_SHELL;

ASSIGNED_PT:
    mul.wide.u32 %rd2, %r5, 16;
    add.u64      %rd3, %rd1, %rd2;
    ld.global.v4.f32 {%f7, %f1, %f8, %f14}, [%rd3]; // x, y, z, class_id

    // Golden-angle spectral color so arbitrary class counts remain distinct
    mul.f32        %f16, %f14, 0f4019999a;          // class_id * 2.4 rad
    cos.approx.f32 %f11, %f16;
    add.f32        %f17, %f16, 0f40060a92;
    cos.approx.f32 %f12, %f17;
    add.f32        %f17, %f16, 0f40860a92;
    cos.approx.f32 %f13, %f17;
    fma.rn.f32 %f11, %f11, 0f3ee66666, 0f3f0ccccd;
    fma.rn.f32 %f12, %f12, 0f3ee66666, 0f3f0ccccd;
    fma.rn.f32 %f13, %f13, 0f3ee66666, 0f3f0ccccd;
    mov.f32    %f15, 0f3f800000;

WRITE_SHELL:
    mul.wide.u32 %rd4, %r5, 32;
    add.u64      %rd5, %rd0, %rd4;
    st.global.v4.f32 [%rd5],    {%f7,  %f1,  %f8,  %f14};
    st.global.v4.f32 [%rd5+16], {%f11, %f12, %f13, %f15};

SHELL_DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel 2: Generic Shadow Accumulation Training Kernel (Any WxH, Any Classes)
// -----------------------------------------------------------------------------
.visible .entry train_accumulate_shadows(
    .param .u64 param_images,      // const uint8_t* (N * pixels_per_img)
    .param .u64 param_class_ids,   // const uint32_t* (N)
    .param .u64 param_shadow_sum,  // float* (num_classes * pixels_per_img)
    .param .u64 param_class_cnt,   // uint32_t* (num_classes)
    .param .u32 param_pixels_img,  // W * H
    .param .u32 param_num_classes,
    .param .u32 param_start_idx,
    .param .u32 param_batch_cnt
)
{
    .reg .pred %p<4>;
    .reg .u32  %r<16>;
    .reg .u64  %rd<14>;
    .reg .f32  %f<4>;

    ld.param.u64 %rd0, [param_images];
    ld.param.u64 %rd1, [param_class_ids];
    ld.param.u64 %rd2, [param_shadow_sum];
    ld.param.u64 %rd3, [param_class_cnt];
    ld.param.u32 %r0,  [param_pixels_img];
    ld.param.u32 %r1,  [param_num_classes];
    ld.param.u32 %r2,  [param_start_idx];
    ld.param.u32 %r3,  [param_batch_cnt];

    mov.u32    %r4, %ctaid.x;
    mov.u32    %r5, %ntid.x;
    mov.u32    %r6, %tid.x;
    mad.lo.u32 %r7, %r4, %r5, %r6;      // tid

    mul.lo.u32 %r8, %r3, %r0;           // batch_cnt * pixels_per_img
    setp.ge.u32 %p0, %r7, %r8;
    @%p0 bra TRAIN_DONE;

    div.u32 %r9,  %r7, %r0;             // local_img
    rem.u32 %r10, %r7, %r0;             // pix
    add.u32 %r11, %r2, %r9;             // global img_idx

    mul.wide.u32  %rd4, %r11, 4;
    add.u64       %rd5, %rd1, %rd4;
    ld.global.u32 %r12, [%rd5];         // class_id
    setp.ge.u32   %p1,  %r12, %r1;
    @%p1 bra TRAIN_DONE;

    setp.ne.u32 %p2, %r10, 0;
    @%p2 bra ACCUM_PIX;
    mul.wide.u32 %rd6, %r12, 4;
    add.u64      %rd7, %rd3, %rd6;
    atom.global.add.u32 %r13, [%rd7], 1;

ACCUM_PIX:
    mul.wide.u32 %rd8, %r11, %r0;
    cvt.u64.u32  %rd9, %r10;
    add.u64      %rd8, %rd8, %rd9;
    add.u64      %rd8, %rd0, %rd8;
    ld.global.u8 %r14, [%rd8];
    setp.eq.u32  %p3,  %r14, 0;
    @%p3 bra TRAIN_DONE;

    cvt.rn.f32.u32 %f0, %r14;
    mul.f32        %f0, %f0, 0f3b808081; // / 255.0

    mul.wide.u32 %rd10, %r12, %r0;
    add.u64      %rd10, %rd10, %rd9;
    shl.b64      %rd10, %rd10, 2;        // * sizeof(float)
    add.u64      %rd11, %rd2, %rd10;
    atom.global.add.f32 %f1, [%rd11], %f0;

TRAIN_DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel 3: GPU Cosine-Overlap Evaluation Kernel (Test Images vs Trained Shadows)
//   1 thread per (img_idx, class_id) -> scores all test images in < 2 ms!
// -----------------------------------------------------------------------------
.visible .entry eval_score_shadows(
    .param .u64 param_images,      // const uint8_t* (num_imgs * pixels_per_img)
    .param .u64 param_templates,   // const float* (num_classes * pixels_per_img), L2-normalized
    .param .u64 param_scores,      // float* (num_imgs * num_classes)
    .param .u32 param_pixels_img,
    .param .u32 param_num_classes,
    .param .u32 param_num_imgs
)
{
    .reg .pred %p<3>;
    .reg .u32  %r<14>;
    .reg .u64  %rd<12>;
    .reg .f32  %f<8>;

    ld.param.u64 %rd0, [param_images];
    ld.param.u64 %rd1, [param_templates];
    ld.param.u64 %rd2, [param_scores];
    ld.param.u32 %r0,  [param_pixels_img];
    ld.param.u32 %r1,  [param_num_classes];
    ld.param.u32 %r2,  [param_num_imgs];

    mov.u32    %r3, %ctaid.x;
    mov.u32    %r4, %ntid.x;
    mov.u32    %r5, %tid.x;
    mad.lo.u32 %r6, %r3, %r4, %r5;      // tid

    mul.lo.u32 %r7, %r2, %r1;           // num_imgs * num_classes
    setp.ge.u32 %p0, %r6, %r7;
    @%p0 bra EVAL_DONE;

    div.u32 %r8, %r6, %r1;              // img_idx
    rem.u32 %r9, %r6, %r1;              // cls_idx

    mul.wide.u32 %rd3, %r8, %r0;
    add.u64      %rd3, %rd0, %rd3;      // img_ptr

    mul.wide.u32 %rd4, %r9, %r0;
    shl.b64      %rd4, %rd4, 2;
    add.u64      %rd4, %rd1, %rd4;      // tmpl_ptr

    mov.f32 %f0, 0f00000000;            // dot = 0
    mov.f32 %f1, 0f00000000;            // norm2 = 0
    mov.u32 %r10, 0;                    // p = 0

EVAL_LOOP:
    setp.ge.u32 %p1, %r10, %r0;
    @%p1 bra EVAL_STORE;

    cvt.u64.u32   %rd5, %r10;
    add.u64       %rd6, %rd3, %rd5;
    ld.global.u8  %r11, [%rd6];
    cvt.rn.f32.u32 %f2, %r11;
    mul.f32        %f2, %f2, 0f3b808081; // x in [0, 1]

    shl.b64       %rd7, %rd5, 2;
    add.u64       %rd8, %rd4, %rd7;
    ld.global.f32 %f3,  [%rd8];          // t

    fma.rn.f32 %f0, %f2, %f3, %f0;       // dot += x * t
    fma.rn.f32 %f1, %f2, %f2, %f1;       // norm2 += x * x
    add.u32    %r10, %r10, 1;
    bra EVAL_LOOP;

EVAL_STORE:
    // Cosine similarity = dot / sqrt(norm2 + 1e-6)
    add.f32         %f1, %f1, 0f358637bd;
    sqrt.approx.f32 %f4, %f1;
    div.approx.f32  %f5, %f0, %f4;

    mul.wide.u32 %rd9, %r6, 4;
    add.u64      %rd10, %rd2, %rd9;
    st.global.f32 [%rd10], %f5;

EVAL_DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel 4: O(Allocated Points) Renderer for 1-Billion-Point Lattice!
//   Launches ONLY (num_regions * max_pixels_per_region) threads, NOT G^3!
//   Supports G = 1241 (~1 billion lattice points) in < 0.05 ms at 60 FPS.
// -----------------------------------------------------------------------------
.visible .entry emit_allocated_regions(
    .param .u64 param_out_vbo,
    .param .u64 param_counter,
    .param .u64 param_regions,     // GpuRegionDesc[num_regions] (32 bytes each)
    .param .u64 param_shadow_avg,  // flat float array of normalized [0..1] shadow maps
    .param .u32 param_num_regions,
    .param .u32 param_max_reg_pix, // max(width*height) across regions
    .param .u32 param_grid_dim,
    .param .u32 param_max_vbo_pts,
    .param .u32 param_focus,       // class_id to highlight, or >= num_regions for all
    .param .u32 param_heatmap      // 0 = class spectral -> white-hot, 1 = thermal shadow map
)
{
    .reg .pred %p<10>;
    .reg .u32  %r<24>;
    .reg .u64  %rd<12>;
    .reg .f32  %f<30>;

    ld.param.u64 %rd0, [param_out_vbo];
    ld.param.u64 %rd1, [param_counter];
    ld.param.u64 %rd2, [param_regions];
    ld.param.u64 %rd3, [param_shadow_avg];
    ld.param.u32 %r0,  [param_num_regions];
    ld.param.u32 %r1,  [param_max_reg_pix];
    ld.param.u32 %r2,  [param_grid_dim];
    ld.param.u32 %r3,  [param_max_vbo_pts];
    ld.param.u32 %r4,  [param_focus];
    ld.param.u32 %r5,  [param_heatmap];

    mov.u32    %r6, %ctaid.x;
    mov.u32    %r7, %ntid.x;
    mov.u32    %r8, %tid.x;
    mad.lo.u32 %r9, %r6, %r7, %r8;      // tid

    mul.lo.u32 %r10, %r0, %r1;
    setp.ge.u32 %p0, %r9, %r10;
    @%p0 bra EMIT_DONE;

    div.u32 %r11, %r9, %r1;             // reg_idx
    rem.u32 %r12, %r9, %r1;             // pix_idx

    // Load 32-byte GpuRegionDesc: {ox, oy, oz, width}, {height, outer_idx, shadow_offset, class_id}
    mul.wide.u32 %rd4, %r11, 32;
    add.u64      %rd5, %rd2, %rd4;
    ld.global.u32 %r13, [%rd5];         // ox
    ld.global.u32 %r14, [%rd5+4];       // oy
    ld.global.u32 %r15, [%rd5+8];       // oz
    ld.global.u32 %r16, [%rd5+12];      // width
    ld.global.u32 %r17, [%rd5+16];      // height
    ld.global.u32 %r18, [%rd5+20];      // outer_idx
    ld.global.u32 %r19, [%rd5+24];      // shadow_offset
    ld.global.u32 %r20, [%rd5+28];      // class_id

    mul.lo.u32 %r21, %r16, %r17;        // w * h
    setp.ge.u32 %p1, %r12, %r21;
    @%p1 bra EMIT_DONE;

    // Load normalized shadow density avg in [0..1]
    add.u32      %r22, %r19, %r12;
    mul.wide.u32 %rd6, %r22, 4;
    add.u64      %rd7, %rd3, %rd6;
    ld.global.f32 %f0, [%rd7];

    // Skip untouched background pixels (<= 0.004)
    setp.le.f32 %p2, %f0, 0f3b83126f;
    @%p2 bra EMIT_DONE;

    // Exact implicit 3D lattice coordinates inside G^3 sphere!
    //   dx = pix_idx % width,  dy = pix_idx / width
    //   ix = ox + dx,  iy = oy + (height - 1 - dy),  iz = oz
    rem.u32 %r22, %r12, %r16;           // dx
    div.u32 %r23, %r12, %r16;           // dy
    add.u32 %r13, %r13, %r22;           // ix
    sub.u32 %r17, %r17, 1;
    sub.u32 %r17, %r17, %r23;           // height - 1 - dy
    add.u32 %r14, %r14, %r17;           // iy

    cvt.rn.f32.u32 %f1, %r2;            // float(G)
    div.approx.f32 %f2, 0f40000000, %f1;// step = 2.0 / G

    cvt.rn.f32.u32 %f3, %r13;
    cvt.rn.f32.u32 %f4, %r14;
    cvt.rn.f32.u32 %f5, %r15;
    add.f32 %f3, %f3, 0f3f000000;
    add.f32 %f4, %f4, 0f3f000000;
    add.f32 %f5, %f5, 0f3f000000;
    fma.rn.f32 %f6, %f3, %f2, 0fbf800000; // x
    fma.rn.f32 %f7, %f4, %f2, 0fbf800000; // y
    fma.rn.f32 %f8, %f5, %f2, 0fbf800000; // z

    // Perceptual shadow curve: wispy outer shadows (sqrt) + white-hot overlap core (d^2)
    mul.f32         %f10, %f0, 0f3f99999a;  // d = min(1.0, avg * 1.20)
    min.f32         %f10, %f10, 0f3f800000;
    sqrt.approx.f32 %f11, %f10;             // vis = sqrt(d)
    mul.f32         %f12, %f10, %f10;       // hot = d^2

    // Focus scaling
    mov.f32 %f13, 0f3f800000;
    setp.ge.u32 %p3, %r4, %r0;
    @%p3 bra SHADE_REG;
    setp.eq.u32 %p4, %r20, %r4;
    @%p4 bra SHADE_REG;
    mov.f32 %f13, 0f3e4ccccd;               // dim non-focused to 0.20

SHADE_REG:
    setp.ne.u32 %p5, %r5, 0;
    @%p5 bra PAL_THERMAL;

    // Class spectral color matching assigned outer-shell point -> white-hot peak core
    cvt.rn.f32.u32 %f14, %r18;
    mul.f32        %f14, %f14, 0f4019999a;  // outer_idx * 2.4 rad
    cos.approx.f32 %f15, %f14;
    add.f32        %f16, %f14, 0f40060a92;
    cos.approx.f32 %f16, %f16;
    add.f32        %f17, %f14, 0f40860a92;
    cos.approx.f32 %f17, %f17;

    fma.rn.f32 %f15, %f15, 0f3ee66666, 0f3f0ccccd;
    fma.rn.f32 %f16, %f16, 0f3ee66666, 0f3f0ccccd;
    fma.rn.f32 %f17, %f17, 0f3ee66666, 0f3f0ccccd;

    mul.f32    %f20, %f15, %f11;
    mul.f32    %f21, %f16, %f11;
    mul.f32    %f22, %f17, %f11;
    fma.rn.f32 %f20, %f12, 0f3f400000, %f20;
    fma.rn.f32 %f21, %f12, 0f3f400000, %f21;
    fma.rn.f32 %f22, %f12, 0f3f400000, %f22;
    bra FINISH_EMIT;

PAL_THERMAL:
    mul.f32 %f20, %f11, 0f3fc00000;
    sub.f32 %f21, %f10, 0f3e99999a;
    max.f32 %f21, %f21, 0f00000000;
    mul.f32 %f21, %f21, 0f40200000;
    sub.f32 %f25, 0f3f800000, %f10;
    mul.f32 %f22, %f25, 0f3eb33333;
    sub.f32 %f26, %f10, 0f3f266666;
    max.f32 %f26, %f26, 0f00000000;
    fma.rn.f32 %f22, %f26, 0f40400000, %f22;

FINISH_EMIT:
    mul.f32    %f20, %f20, %f13;
    mul.f32    %f21, %f21, %f13;
    mul.f32    %f22, %f22, %f13;
    min.f32    %f20, %f20, 0f3f800000;
    min.f32    %f21, %f21, 0f3f800000;
    min.f32    %f22, %f22, 0f3f800000;
    fma.rn.f32 %f23, %f11, 0f3f59999a, 0f3e19999a;
    mul.f32    %f23, %f23, %f13;

    atom.global.add.u32 %r23, [%rd1], 1;
    setp.ge.u32 %p6, %r23, %r3;
    @%p6 bra EMIT_DONE;

    mul.wide.u32 %rd8, %r23, 32;
    add.u64      %rd9, %rd0, %rd8;
    st.global.v4.f32 [%rd9],    {%f6,  %f7,  %f8,  %f10};
    st.global.v4.f32 [%rd9+16], {%f20, %f21, %f22, %f23};

EMIT_DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel 5: 2-Stage Hardware-Pruned Non-Linear Bernoulli Log-Likelihood Matcher
//   Stage 1: 64-bit coarse 8x8 occupancy bitmask (and.b64 + popc.b64)
//            Deterministically prunes impossible classes in 2 clock cycles!
//   Stage 2: Multi-shift (dx, dy in {-1, 0, +1}) bias-free symmetric Bernoulli
//            log-likelihood (ideal-template normalized):
//              LL(x, c) = sum[ x*log(p) + (1-x)*log(1-p) ]
//              bias[c]  = sum[ log(1-p) ] - 0.5 * L_max(p_c)   (cancels sparse bias!)
//              score    = exp(min(0, LL - 0.5*L_max(p_c) - 0.5*H(x)) / T)  (1 FMA/pix!)
// -----------------------------------------------------------------------------
.visible .entry match_sketch_pruned(
    .param .u64 param_sketch_raw,      // const float[num_hyps * pixels_img] in [0..1]
    .param .u64 param_sketch_self_ent, // const float[num_hyps] self-entropy 0.5*H(x)
    .param .u64 param_sketch_masks,    // const uint64_t[num_hyps] 8x8 coarse occupancy masks (per Gaussian pyramid level & shift)
    .param .u64 param_class_masks,     // const uint64_t[num_classes]
    .param .u64 param_class_log_odds,  // const float[num_classes * pixels_img]: log(p/(1-p))
    .param .u64 param_class_prob,      // const float[num_classes * pixels_img]: canonical shadow density in [0..1]
    .param .u64 param_class_bias,      // const float[num_classes]: sum log(1-p) - 0.5*L_max(p)
    .param .u64 param_out_overlap,     // float[num_classes] in [0.0 .. 1.0]
    .param .u64 param_out_status,      // uint32_t[num_classes]: 0=PRUNED, 1=CONFIRMED
    .param .u32 param_pixels_img,
    .param .u32 param_num_classes,
    .param .u32 param_num_shifts,      // total multi-scale pyramid hypotheses (e.g. 3 octaves x 9 shifts = 27)
    .param .f32 param_prune_ratio,     // min fraction of Q bits overlapping class mask
    .param .f32 param_inv_t_ln2        // 1.0 / (T * ln(2)) for ex2.approx.f32
)
{
    .reg .pred %p<6>;
    .reg .u32  %r<14>;
    .reg .u64  %rd<22>;
    .reg .f32  %f<20>;

    ld.param.u64 %rd0,  [param_sketch_raw];
    ld.param.u64 %rd1,  [param_sketch_self_ent];
    ld.param.u64 %rd2,  [param_sketch_masks];
    ld.param.u64 %rd3,  [param_class_masks];
    ld.param.u64 %rd4,  [param_class_log_odds];
    ld.param.u64 %rd20, [param_class_prob];
    ld.param.u64 %rd5,  [param_class_bias];
    ld.param.u64 %rd6,  [param_out_overlap];
    ld.param.u64 %rd7,  [param_out_status];
    ld.param.u32 %r0,   [param_pixels_img];
    ld.param.u32 %r1,   [param_num_classes];
    ld.param.u32 %r2,   [param_num_shifts];
    ld.param.f32 %f0,   [param_prune_ratio];
    ld.param.f32 %f1,   [param_inv_t_ln2];

    mov.u32    %r3, %ctaid.x;
    mov.u32    %r4, %ntid.x;
    mov.u32    %r5, %tid.x;
    mad.lo.u32 %r6, %r3, %r4, %r5;      // cls_idx
    setp.ge.u32 %p0, %r6, %r1;
    @%p0 bra MATCH_DONE;

    // Load class coarse 64-bit footprint mask M once
    mul.wide.u32  %rd8,  %r6, 8;
    add.u64       %rd9,  %rd3, %rd8;
    ld.global.u64 %rd10, [%rd9];        // class_mask M

    // Preload class bias & base pointers for Stage-2 multi-scale matching
    mul.wide.u32  %rd12, %r6, 4;
    add.u64       %rd13, %rd5, %rd12;
    ld.global.f32 %f5,   [%rd13];       // class_bias

    mul.wide.u32 %rd12, %r6, %r0;
    shl.b64      %rd12, %rd12, 2;
    add.u64      %rd14, %rd4,  %rd12;   // class_log_odds ptr
    add.u64      %rd21, %rd20, %rd12;   // class_prob ptr

    mov.f32 %f6,  0f00000000;           // best_score = 0.0
    mov.u32 %r11, 0;                    // survived_hyps = 0
    mov.u32 %r9,  0;                    // hyp_idx s = 0

SHIFT_LOOP:
    setp.ge.u32 %p4, %r9, %r2;
    @%p4 bra SHIFT_DONE;

    // --- Stage 1 (Per-Hypothesis): Hardware 64-bit Coarse Bitmask Pruning (2 cycles!) ---
    mul.wide.u32  %rd15, %r9, 8;
    add.u64       %rd16, %rd2, %rd15;
    ld.global.u64 %rd11, [%rd16];       // Q = sketch_masks[s]

    and.b64  %rd8, %rd11, %rd10;        // Q & M
    popc.b64 %r7,  %rd11;               // popc(Q)
    popc.b64 %r8,  %rd8;                // popc(Q & M)

    setp.eq.u32 %p1, %r7, 0;
    @%p1 bra NEXT_SHIFT;
    setp.eq.u32 %p2, %r8, 0;
    @%p2 bra NEXT_SHIFT;

    cvt.rn.f32.u32 %f2, %r8;
    cvt.rn.f32.u32 %f3, %r7;
    div.approx.f32 %f4, %f2, %f3;       // hit_ratio = popc(Q & M) / popc(Q)
    setp.lt.f32 %p3, %f4, %f0;          // hit_ratio < prune_ratio -> skip this pyramid hypothesis!
    @%p3 bra NEXT_SHIFT;

    add.u32 %r11, %r11, 1;              // survived_hyps++

    // --- Stage 2: Symmetric Bernoulli x Continuous Soft-IoU Completeness ---
    mul.wide.u32  %rd15, %r9, 4;
    add.u64       %rd16, %rd1, %rd15;
    ld.global.f32 %f7,   [%rd16];       // self_entropy 0.5*H(x) for hyp s

    mul.wide.u32 %rd15, %r9, %r0;
    shl.b64      %rd15, %rd15, 2;
    add.u64      %rd16, %rd0, %rd15;    // sketch_raw ptr for hyp s

    mov.f32 %f8,  %f5;                  // ll = class_bias
    mov.f32 %f13, 0f00000000;           // inter = 0.0 (sum min(x, p))
    mov.f32 %f14, 0f00000000;           // union = 0.0 (sum max(x, p))
    mov.u32 %r10, 0;                    // p = 0

PIX_LOOP:
    setp.ge.u32 %p5, %r10, %r0;
    @%p5 bra SHIFT_EVAL;

    mul.wide.u32  %rd17, %r10, 4;
    add.u64       %rd18, %rd16, %rd17;
    ld.global.f32 %f9,   [%rd18];       // x[p]
    add.u64       %rd18, %rd14, %rd17;
    ld.global.f32 %f10,  [%rd18];       // log_odds[c, p]
    fma.rn.f32    %f8,   %f9, %f10, %f8;// ll += x[p] * log_odds[c, p]

    add.u64       %rd18, %rd21, %rd17;
    ld.global.f32 %f15,  [%rd18];       // p[c, p]
    min.f32       %f16,  %f9, %f15;
    max.f32       %f17,  %f9, %f15;
    add.f32       %f13,  %f13, %f16;    // inter += min(x, p)
    add.f32       %f14,  %f14, %f17;    // union += max(x, p)

    add.u32 %r10, %r10, 1;
    bra PIX_LOOP;

SHIFT_EVAL:
    // 1) Symmetric Bernoulli similarity = exp(min(0, ll - 0.5*H(x)) / T)
    sub.f32        %f11, %f8,  %f7;
    min.f32        %f11, %f11, 0f00000000;
    mul.f32        %f11, %f11, %f1;
    ex2.approx.f32 %f12, %f11;
    max.f32        %f12, %f12, 0f00000000;
    min.f32        %f12, %f12, 0f3f800000;

    // 2) Continuous Soft-IoU density completeness = sum min(x,p) / (sum max(x,p) + 1e-6)
    add.f32        %f14, %f14, 0f358637bd;
    div.approx.f32 %f18, %f13, %f14;
    mul.f32        %f12, %f12, %f18;

    max.f32 %f6, %f6, %f12;             // best_score = max(best_score, score)

NEXT_SHIFT:
    add.u32 %r9, %r9, 1;
    bra SHIFT_LOOP;

SHIFT_DONE:
    setp.eq.u32 %p1, %r11, 0;
    @%p1 bra PRUNE_OUT;

MATCH_CONFIRM:
    mul.wide.u32  %rd18, %r6, 4;
    add.u64       %rd19, %rd6, %rd18;
    st.global.f32 [%rd19], %f6;
    add.u64       %rd19, %rd7, %rd18;
    st.global.u32 [%rd19], 1;           // CONFIRMED
    bra MATCH_DONE;

PRUNE_OUT:
    mul.wide.u32  %rd18, %r6, 4;
    add.u64       %rd19, %rd6, %rd18;
    st.global.f32 [%rd19], 0f00000000;
    add.u64       %rd19, %rd7, %rd18;
    st.global.u32 [%rd19], 0;           // PRUNED

MATCH_DONE:
    ret;
}

// -----------------------------------------------------------------------------
// Kernel 6: Operational Manifold GPU Routing & Semantic Metadata Verification
//   Operates directly on the 128-byte GpuManifoldDesc metadata register in VRAM
//   (mapping each bounded subspace directly to its formal semantic label, e.g.
//    fundamental_text / handwritten_letters_and_numbers) and aggregates peak
//   sub-shadow match score + surviving subspace count per manifold on the GPU!
// -----------------------------------------------------------------------------
.visible .entry route_operational_manifolds(
    .param .u64 param_manifolds,       // const GpuManifoldDesc[num_manifolds] (128 bytes each)
    .param .u64 param_region_manifold, // const uint32_t[num_regions]
    .param .u64 param_region_overlap,  // const float[num_regions]
    .param .u64 param_region_status,   // const uint32_t[num_regions]
    .param .u64 param_out_best_score,  // float[num_manifolds]
    .param .u64 param_out_best_region, // uint32_t[num_manifolds] (0xFFFFFFFF if none)
    .param .u64 param_out_active_cnt,  // uint32_t[num_manifolds]
    .param .u32 param_num_manifolds,
    .param .u32 param_num_regions
)
{
    .reg .pred %p<5>;
    .reg .u32  %r<16>;
    .reg .u64  %rd<16>;
    .reg .f32  %f<4>;

    ld.param.u64 %rd0, [param_manifolds];
    ld.param.u64 %rd1, [param_region_manifold];
    ld.param.u64 %rd2, [param_region_overlap];
    ld.param.u64 %rd3, [param_region_status];
    ld.param.u64 %rd4, [param_out_best_score];
    ld.param.u64 %rd5, [param_out_best_region];
    ld.param.u64 %rd6, [param_out_active_cnt];
    ld.param.u32 %r0,  [param_num_manifolds];
    ld.param.u32 %r1,  [param_num_regions];

    mov.u32    %r2, %ctaid.x;
    mov.u32    %r3, %ntid.x;
    mov.u32    %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;      // m_idx
    setp.ge.u32 %p0, %r5, %r0;
    @%p0 bra MAN_DONE;

    // Load manifold_id from 144-byte GpuManifoldDesc metadata register at offset 0
    mul.wide.u32  %rd7, %r5, 144;
    add.u64       %rd8, %rd0, %rd7;
    ld.global.u32 %r6,  [%rd8];         // target_manifold_id

    mov.f32 %f0, 0f00000000;            // best_score = 0.0
    mov.u32 %r7, 0xffffffff;            // best_region = 0xFFFFFFFF
    mov.u32 %r8, 0;                     // active_cnt = 0
    mov.u32 %r9, 0;                     // r = 0

MAN_LOOP:
    setp.ge.u32 %p1, %r9, %r1;
    @%p1 bra MAN_STORE;

    mul.wide.u32  %rd9,  %r9, 4;
    add.u64       %rd10, %rd1, %rd9;
    ld.global.u32 %r10,  [%rd10];       // region_manifold[r]
    setp.ne.u32   %p2,   %r10, %r6;
    @%p2 bra MAN_NEXT;

    add.u64       %rd11, %rd3, %rd9;
    ld.global.u32 %r11,  [%rd11];       // region_status[r]
    setp.eq.u32   %p3,   %r11, 0;
    @%p3 bra MAN_NEXT;

    add.u32       %r8,   %r8, 1;        // active_cnt++
    add.u64       %rd12, %rd2, %rd9;
    ld.global.f32 %f1,   [%rd12];       // overlap[r]
    setp.le.f32   %p4,   %f1, %f0;
    @%p4 bra MAN_NEXT;

    mov.f32 %f0, %f1;
    mov.u32 %r7, %r9;

MAN_NEXT:
    add.u32 %r9, %r9, 1;
    bra MAN_LOOP;

MAN_STORE:
    mul.wide.u32  %rd13, %r5, 4;
    add.u64       %rd14, %rd4, %rd13;
    st.global.f32 [%rd14], %f0;
    add.u64       %rd14, %rd5, %rd13;
    st.global.u32 [%rd14], %r7;
    add.u64       %rd14, %rd6, %rd13;
    st.global.u32 [%rd14], %r8;

MAN_DONE:
    ret;
}
